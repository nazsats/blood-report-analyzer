rules_version = '2';

// Blood Lab Firestore security rules.
//
// The server (Firebase Admin SDK in /api routes) bypasses these rules entirely,
// so everything the API writes keeps working. These rules only constrain the
// browser and mobile clients.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    /** Fields the client must never set on itself — these decide what it pays. */
    function touchesBilling() {
      return request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['pro', 'freeUploadsUsed', 'subscriptionEnd', 'subscriptionId']);
    }

    // ---- users/{uid} : billing state, owned by the server -------------------
    // Read is fine. Write was previously unrestricted, which meant any signed-in
    // user could set pro:true on their own document from the client console and
    // take unlimited paid analyses for free — the paywall is enforced by reading
    // exactly these fields. Profile edits stay allowed; billing fields do not.
    match /users/{uid} {
      allow read:   if isOwner(uid);
      allow create: if isOwner(uid) && !request.resource.data.keys()
                       .hasAny(['pro', 'freeUploadsUsed', 'subscriptionEnd', 'subscriptionId']);
      allow update: if isOwner(uid) && !touchesBilling();
      allow delete: if false;
    }

    // ---- mobileUsers/{uid} : profile written by the app ---------------------
    // The mobile app stores age, blood type, medications and conditions here and
    // the analyze route reads them for personalisation. There was no rule for
    // this collection, so it fell through to the deny-all at the bottom and
    // every profile read and write from the app was being rejected.
    match /mobileUsers/{uid} {
      allow read, write: if isOwner(uid);
    }

    // ---- reports/{reportId} ------------------------------------------------
    match /reports/{reportId} {

      // Fetching one document by its id: owner only.
      allow get: if signedIn() && resource.data.userId == request.auth.uid;

      // KNOWN EXPOSURE — the share page (app/share/[shareId]/page.tsx) queries
      // this collection while signed out, so shared documents must be listable.
      // Every report gets a shareId stamped on it by the analyze route, so in
      // practice this clause makes every report in the database listable by an
      // unauthenticated caller who queries the collection directly. These are
      // blood test results.
      //
      // The fix is to stop the browser reading `reports` at all: move the share
      // page onto a server route that looks the document up with the Admin SDK
      // and returns only the fields a share needs. Then this clause becomes
      // owner-only. Left in place for now because removing it breaks a live
      // feature, but it should not survive a public launch.
      allow list: if (signedIn() && resource.data.userId == request.auth.uid)
                  || resource.data.shareId != null;

      allow update: if signedIn()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == resource.data.userId;

      allow delete: if signedIn() && resource.data.userId == request.auth.uid;

      // Reports are created by the server, never by a client.
      allow create: if false;
    }

    // ---- rateLimits/{bucket}:{uid} : server only ---------------------------
    // Written by lib/rateLimit.ts through the Admin SDK. A client that could
    // write here could reset its own counter, so it gets nothing.
    match /rateLimits/{docId} {
      allow read, write: if false;
    }

    // ---- mealLogs/{uid}_{date} : written by the server, read by the owner ---
    match /mealLogs/{logId} {
      allow read: if signedIn() && logId.split('_')[0] == request.auth.uid;
      allow write: if false;

      match /entries/{entryId} {
        allow read: if signedIn() && logId.split('_')[0] == request.auth.uid;
        allow write: if false;
      }
    }

    // ---- weightLogs / workouts : owner-scoped app data ----------------------
    // Both are behind Coming soon in the app today. The rules are here so the
    // features work the day they are switched on, rather than failing silently
    // against a deny-all that nobody remembers to update.
    match /weightLogs/{docId} {
      allow read, write: if signedIn() && docId.split('_')[0] == request.auth.uid;
    }

    match /workouts/{docId} {
      allow read, write: if signedIn() && docId.split('_')[0] == request.auth.uid;
    }

    // ---- community : postStats, postVotes, postComments --------------------
    // Reads are public because the feed is public. Writes require a signed-in
    // user and, for a vote, that the document is keyed to that user so nobody
    // can overwrite someone else's.
    match /postStats/{postId} {
      allow read: if true;
      allow write: if false;   // counters are server-maintained
    }

    match /postCommentCounts/{postId} {
      allow read: if true;
      allow write: if false;
    }

    match /postVotes/{voteId} {
      allow read: if true;
      allow write: if signedIn() && voteId.split('_')[0] == request.auth.uid;
    }

    match /postComments/{commentId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // ---- everything else is denied ----------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
